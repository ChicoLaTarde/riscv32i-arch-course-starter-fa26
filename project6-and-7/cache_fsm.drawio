            <Array as="points">
              <mxPoint x="705" y="880" />
              <mxPoint x="690" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n17" value="Both ways use the same set index; tags are compared in parallel." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#253449;fontStyle=0;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="850" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mem" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Backing-memory interface&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;o_mem_addr[31:0]: word-aligned address.&lt;br&gt;o_mem_ren / o_mem_wen: gated by ready.&lt;br&gt;o_mem_wdata[31:0]: merged full store word.&lt;br&gt;i_mem_ready: request acceptance.&lt;br&gt;i_mem_valid / i_mem_rdata: read response.&lt;br&gt;No byte-mask port; no write-complete input." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF0DC;strokeColor=#C68B3C;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="1080" y="640" width="600" height="235" as="geometry" />
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="ctl" target="mem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.3;strokeColor=#C68B3C;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="Refill: read line_base + {0, 4, 8, 12}.&lt;br&gt;Store: write saved word address with merged data." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#253449;fontStyle=0;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1080" y="895" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Capacity and metadata&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Data: 32 sets × 2 ways × 16 bytes = 1,024 bytes.&lt;br&gt;Metadata: 64 valid bits + 64 × 23 tag bits + 32 MRU bits.&lt;br&gt;One MRU bit per set; no dirty bits." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#F5F7FA;strokeColor=#C5CFDA;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="1080" y="990" width="600" height="150" as="geometry" />
