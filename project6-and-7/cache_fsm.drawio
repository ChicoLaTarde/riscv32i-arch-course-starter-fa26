  <diagram name="Cache Organization" id="cache-organization">
    <mxGraphModel dx="1740" dy="1170" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1170" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="CACHE ORGANIZATION AND CONTROL" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#253449;fontStyle=1;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="32-bit byte address  •  word-aligned CPU requests  •  little-endian byte lanes" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#253449;fontStyle=0;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;TAG [31:9]&lt;/b&gt;&lt;br&gt;23 bits" style="rounded=0;html=1;align=center;verticalAlign=middle;fillColor=#EAF2FF;strokeColor=#4674AC;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;SET [8:4]&lt;/b&gt;&lt;br&gt;5 bits / 32 sets" style="rounded=0;html=1;align=center;verticalAlign=middle;fillColor=#F1EAFF;strokeColor=#8060AC;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;WORD [3:2]&lt;/b&gt;&lt;br&gt;2 bits / 4 words" style="rounded=0;html=1;align=center;verticalAlign=middle;fillColor=#E7F5EE;strokeColor=#4B9270;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1170" y="160" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;[1:0]&lt;/b&gt;&lt;br&gt;00" style="rounded=0;html=1;align=center;verticalAlign=middle;fillColor=#F5F7FA;strokeColor=#A7B3C0;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="1450" y="160" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;CPU request&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;i_req_addr[31:0]&lt;br&gt;i_req_ren / i_req_wen&lt;br&gt;i_req_mask[3:0]&lt;br&gt;i_req_wdata[31:0]&lt;br&gt;Output: o_busy, o_res_rdata[31:0]" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EAF2FF;strokeColor=#4674AC;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="saved" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Saved request registers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Address, read/write kind, mask, data.&lt;br&gt;Also retain victim / hit way and&lt;br&gt;2-bit refill word counter.&lt;br&gt;line_base = {saved_addr[31:4], 4&amp;#x27;b0}" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#F5F7FA;strokeColor=#A7B3C0;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="510" y="310" width="490" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;FSM controller&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;States on the Cache FSM page.&lt;br&gt;Controls cache updates, word counter,&lt;br&gt;request capture and memory requests.&lt;br&gt;One outstanding memory read at a time." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EDF5FB;strokeColor=#4674AC;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="1160" y="310" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="cpu" target="saved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.3;strokeColor=#425A78;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="saved" target="ctl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.3;strokeColor=#425A78;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="way0" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;WAY 0&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;32 × valid bit&lt;br&gt;32 × 23-bit tag&lt;br&gt;32 × 4 × 32-bit data words&lt;br&gt;Read selected set and word." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EAF2FF;strokeColor=#4674AC;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="way1" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;WAY 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;32 × valid bit&lt;br&gt;32 × 23-bit tag&lt;br&gt;32 × 4 × 32-bit data words&lt;br&gt;Read selected set and word." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#EAF2FF;strokeColor=#4674AC;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="510" y="640" width="390" height="190" as="geometry" />
        </mxCell>
        <mxCell id="hit" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Tag comparison and word select&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;hit0 = valid0[set] &amp;amp;&amp;amp; (tag0[set] == tag)&lt;br&gt;hit1 = valid1[set] &amp;amp;&amp;amp; (tag1[set] == tag)&lt;br&gt;hit = hit0 || hit1; select matching way.&lt;br&gt;Read hits return the 32-bit word immediately." style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#E7F5EE;strokeColor=#4B9270;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=17;fontColor=#172B45;" vertex="1" parent="1">
          <mxGeometry x="60" y="925" width="840" height="185" as="geometry" />
        </mxCell>
        <mxCell id="e15" edge="1" parent="1" source="way0" target="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.3;strokeColor=#4B9270;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="255" y="880" />
              <mxPoint x="270" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="way1" target="hit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.3;strokeColor=#4B9270;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;">
