          <mxGeometry x="80" y="1110" width="1340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="wr = saved write flag; c = refill word (0–3). Victim: invalid way first, otherwise NOT MRU[set]." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;align=left;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#111111;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="1145" width="1340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="Refill address = line base + 4c. Store address = saved word address. merged = (old &amp;amp; ~M) | (saved_data &amp;amp; M)." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;align=left;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#111111;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="1180" width="1340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="M expands the byte mask. Busy asserts immediately on a miss or store, until IDLE. Otherwise stay; default memory enables = 0." style="text;html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;align=left;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#111111;spacing=5;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
